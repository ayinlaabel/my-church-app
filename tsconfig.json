{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-native",
    "esModuleInterop": true,
    "strict": true,
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@constants/*": ["./src/constants/*"],
      "@libs/*": ["./src/libs/*"],
      "@declared-types/*": ["./src/types/*"],
      "@utils/*": ["./src/utils/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@navigation/*": ["./src/navigation/*"],
      "@mocks/*": ["./src/__mocks__/*"],
      "@networking/*": ["./src/networking/*"],
      "@screens/*": ["./src/screens/*"],
      "@configs/*": ["./src/configs/*"],
      "@components/*": ["./src/components/*"],
      "@theme/*": ["./src/theme/*"],
      "@contexts/*": ["./src/contexts/*"],
      "@services/*": ["./src/services/*"]
    }
  }
}
