{
  "name": "mychurchapp",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/stack": "^7.10.23",
    "@tanstack/react-query": "^5.102.3",
    "axios": "^1.19.0",
    "expo": "~57.0.20",
    "expo-auth-session": "~57.0.11",
    "expo-build-properties": "~57.0.17",
    "expo-camera": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-local-authentication": "^57.0.2",
    "expo-media-library": "~57.0.4",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.18.0",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-hook-form": "^7.86.0",
    "react-native": "0.86.3",
    "react-native-big-calendar": "^4.19.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "start": "expo start",
    "dev": "export NODE_ENV=development && expo start --dev-client",
    "dev-win": "set \"NODE_ENV=development\" && expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "eas:pull:env": "npx eas env:pull",
    "build:dev:android": "npx eas-cli@latest build --profile development --platform android",
    "build:dev:ios": "npx eas-cli@latest build --profile development --platform ios",
    "build:dev:simulator": "npx eas-cli@latest build --profile development-simulator --platform ios",
    "build:uat:android": "npx eas-cli@latest build --profile uat --platform android",
    "build:uat:ios": "npx eas-cli@latest build --profile uat --platform ios",
    "build:prod:android": "npx eas-cli@latest build --profile production --platform android",
    "build:prod:ios": "npx eas-cli@latest build --profile production --platform ios",
    "ci:dev": "npx eas-cli@latest build --profile development --platform all --no-wait --non-interactive",
    "ci:dev:simulator": "npx eas-cli@latest build --profile development-simulator --platform ios --no-wait --non-interactive",
    "ci:uat": "npx eas-cli@latest build --profile uat --platform all --no-wait --non-interactive",
    "ci:prod": "npx eas-cli@latest build --profile production --platform all --no-wait --non-interactive",
    "eas-build-pre-install": "node ./scripts/pre-install.js",
    "eas-build-on-success": "node ./scripts/post-install.js",
    "test": "jest",
    "postinstall": "patch-package",
    "update-version": "node ./scripts/update-version.js",
    "eas-push-secrets": "npx eas-cli@latest secret:push --scope project --env-file .env --force",
    "eas-add-device": "npx eas-cli@latest device:create"
  },
  "private": true
}
